// Copy-paste these into: Firebase Console → Firestore Database → Rules
// (see README.md section 6). These rules make sure:
//   - a logged-in user can read/write only THEIR OWN role document
//   - nobody can read or change anyone else's role from the browser
//     (so a "viewer" can't just edit their own role to "admin" via code)
//
// To promote someone to admin, YOU do it manually from the Firebase Console
// (Firestore Database → users → <their uid> → edit the "role" field).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      // Disallow client-side updates to role — only editable from Console.
      allow update: if false;
      allow delete: if false;
    }
  }
}
