<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="
            http://www.ehcache.org/v3 https://www.ehcache.org/schema/ehcache-core.xsd
            http://www.ehcache.org/v3/jsr107 https://www.ehcache.org/schema/ehcache-107-ext.xsd">

    <service>
        <jsr107:defaults enable-management="false" enable-statistics="false"/>
    </service>

    <!-- Pages of the post feed, one entry per (author, page, size, sort) combination -->
    <cache alias="posts">
        <expiry><ttl unit="seconds">60</ttl></expiry>
        <heap unit="entries">500</heap>
    </cache>

    <!-- Top posts (native SQL query) -->
    <cache alias="topPosts">
        <expiry><ttl unit="seconds">60</ttl></expiry>
        <heap unit="entries">20</heap>
    </cache>

    <!-- Dashboard numbers -->
    <cache alias="analytics">
        <expiry><ttl unit="seconds">120</ttl></expiry>
        <heap unit="entries">5</heap>
    </cache>
</config>
